@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="about">
    <h1>@Model.Title</h1>
    <p class="lede">@Model.Detail</p>
    <p><a class="primary-link" asp-controller="Projects" asp-action="Index">Back to contents</a></p>

    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID: <code>@Model.RequestId</code></p>
    }
</section>